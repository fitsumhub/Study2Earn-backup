# ==============================================================================
# Study2Earn Environment Configuration
# Copy this file to `.env` and configure your API keys.
# .env is gitignored — NEVER commit real secret keys into source control.
# ==============================================================================

# ── Google Gemini API (Primary AI Engine) ────────────────────────────────────
# Required for real AI Study Sets generation, structured overviews, flashcards,
# quizzes, cheat sheets, university written exam rubrics, and cloze exercises.
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Supported Google Gemini Models:
# - gemini-flash-lite-latest (Default: Ultra-fast, highly reliable, high rate-limit)
# - gemini-3.5-flash-lite
# - gemini-3.5-flash
# - gemini-3.8-flash
# - gemini-flash-latest

# ── Optional Alternate AI Providers ──────────────────────────────────────────
# Only required if you change the active AI provider in Admin → Integrations
# or configure multi-provider fallback.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Groq Cloud (https://console.groq.com/)
GROQ_API_KEY=

# Custom / Self-Hosted OpenAI-Compatible Gateway
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
