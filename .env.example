# Copy this file to `.env` and fill in the values you need. `.env` is
# gitignored — never commit real keys.

# AI Study — required for real question/notes generation (Admin → API &
# Integrations → AI Study). Without this, AI Study silently falls back to
# its built-in sample question bank. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional alternate providers for AI Study (only needed if you switch the
# provider in Admin → API & Integrations away from the Anthropic default).
DEEPSEEK_API_KEY=
CUSTOM_AI_API_KEY=
